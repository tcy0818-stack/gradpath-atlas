# Copy to .env.local and fill in. Never commit .env.local or paste real values into chat.
# Values below are placeholders only.

# --- Browser-safe (exposed to the browser by design; data is protected by Row Level Security) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- SECRET: server only. Used solely by the account-deletion route (built in Phase 6). ---
# Never prefix with NEXT_PUBLIC_, never import from client code, never print it.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# --- OPTIONAL, test-only: used by `npm run check:api-isolation` (never by the app) ---
# Two throw-away accounts you created through /signup and confirmed. Use unrelated passwords, never real ones.
TEST_USER_A_EMAIL=test-a@example.com
TEST_USER_A_PASSWORD=replace_me
TEST_USER_B_EMAIL=test-b@example.com
TEST_USER_B_PASSWORD=replace_me
